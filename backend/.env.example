# Frontend origins allowed to call the API from a browser.
# Use a JSON list with no trailing slash on each origin.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Browser origins allowed to access the API.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# Local PostgreSQL connection.
DB_HOST=::1
DB_PORT=5432
DB_NAME=MedullaAPI
DB_USER=medula_app

# Set your own password in .env. Never commit real credentials.
DB_PASSWORD=your_password_here
# Enable deliberately for local account creation.
REGISTRATION_ENABLED=false

# Rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=medula_app
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=medula
RABBITMQ_TLS=false

RABBITMQ_EXCHANGE=medulla.events
RABBITMQ_INGESTION_QUEUE=document.ingestion
RABBITMQ_INGESTION_ROUTING_KEY=document.ingestion.requested

# Ingestion worker. Keep prefetch low while one worker owns the full pipeline.
INGESTION_WORKER_PREFETCH_COUNT=1
INGESTION_WORKER_LEASE_SECONDS=60

# Separately runnable expired-lease recovery process.
INGESTION_RECOVERY_POLL_SECONDS=5
INGESTION_RECOVERY_BATCH_SIZE=50
INGESTION_RECOVERY_ERROR_BACKOFF_SECONDS=1
INGESTION_RECOVERY_MAX_ERROR_BACKOFF_SECONDS=30

# Separately runnable transactional-outbox publisher.
OUTBOX_PUBLISHER_POLL_SECONDS=1
OUTBOX_PUBLISHER_BATCH_SIZE=50
OUTBOX_PUBLISHER_CLAIM_SECONDS=30
OUTBOX_PUBLISHER_ERROR_BACKOFF_SECONDS=1
OUTBOX_PUBLISHER_MAX_ERROR_BACKOFF_SECONDS=30

# Private document object storage. Authentication uses Application Default
# Credentials; never put a service-account JSON key in this file.
STORAGE_PROVIDER=gcs
STORAGE_BUCKET=medula-dev-medullaapi-documents
GCP_PROJECT_ID=medullaapi

# Vertex AI document embeddings. Authentication uses the same Application
# Default Credentials as GCS. Silent input truncation is disabled.
EMBEDDING_PROVIDER=vertex_ai
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=1
EMBEDDING_LOCATION=global
EMBEDDING_TIMEOUT_SECONDS=30

# Vertex AI structured relation extraction. The stage reads exact chunk text,
# validates the structured response, and stores a versioned JSON artifact.
RELATION_EXTRACTION_PROVIDER=vertex_ai
RELATION_EXTRACTION_MODEL=gemini-2.5-flash
RELATION_EXTRACTION_LOCATION=global
RELATION_EXTRACTION_TIMEOUT_SECONDS=60

LOG_LEVEL=INFO

# Generate a private random key of at least 32 bytes; never commit the real key.
AUTH_SIGNING_KEY=
# Set false only for local HTTP testing. Production requires HTTPS and true.
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000","http://127.0.0.1:8000"]
